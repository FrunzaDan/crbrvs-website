    "@angular/router": "^22.2.0",
    "@angular/ssr": "^22.2.0",
    "@emailjs/browser": "^4.4.1",
    "bootstrap-icons": "^1.13.1",
    "firebase": "^12.19.0",
    "rxjs": "^7.8.2"
  },
  "devDependencies": {
    "@angular/build": "^22.2.0",
    "@angular/cli": "^22.2.0",
    "@angular/compiler-cli": "^22.2.0",
    "@types/node": "^26.6.3",
    "jsdom": "^30.1.1",
